# Copy to `.env` (or run `make init`, which writes it for you).
# docker-compose reads this file automatically.

# Run every container as your host user so files written to ./data are readable
# and editable from your machine without sudo.  On Linux: AIRFLOW_UID=$(id -u).
# On macOS/Windows with Docker Desktop the default 50000 is fine.
AIRFLOW_UID=50000

# --- shared pipeline settings (see src/pipeline/config.py) -------------------
DATA_ROOT=/data
LOG_LEVEL=INFO

# --- MQTT (streaming source) ------------------------------------------------
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPIC=logs/#

# Micro-batching: flush a landing file after N messages OR N seconds.
# Lower these for lower latency, raise them for fewer/larger files.
STREAM_BATCH_SIZE=200
STREAM_FLUSH_SECONDS=30

# --- demo data generator ----------------------------------------------------
SIM_EVENTS_PER_SECOND=5
SIM_BACKFILL_DAYS=3
SIM_EVENTS_PER_BACKFILL_DAY=5000
